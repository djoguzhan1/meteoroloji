+  for (const [locKey, runs] of Object.entries(ledger.calibratedRuns)) {
+    const filtered = runs
+      .filter((r) => r.createdAtMs >= cutoffMs)
+      .slice(-MAX_RUNS_PER_LOC);
+    if (filtered.length === 0) {
