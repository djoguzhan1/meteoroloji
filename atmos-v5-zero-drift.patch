+  for (const [stId, hourMap] of Object.entries(ledger.stations)) {
+    for (const [uKey, pt] of Object.entries(hourMap)) {
+      if (pt.observedAtMs < cutoffMs) {
+        delete hourMap[uKey];
+      }
+    }
+    if (Object.keys(hourMap).length === 0) {
+      delete ledger.stations[stId];
+    }
+  }
