+  for (const [locKey, hourMap] of Object.entries(ledger.targetHistory)) {
+    for (const [uKey, pt] of Object.entries(hourMap)) {
+      if (pt.observedAtMs < cutoffMs) {
+        delete hourMap[uKey];
+      }
+    }
+    if (Object.keys(hourMap).length === 0) {
+      delete ledger.targetHistory[locKey];
+    }
+  }
